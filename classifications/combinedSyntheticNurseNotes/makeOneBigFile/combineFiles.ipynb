   "metadata": {},
   "outputs": [],
   "source": [
    "all_dfs = []\n",
    "for file in os.listdir('../'):\n",
    "    if '.csv' in file:\n",
    "        all_dfs.append(pd.read_csv(f'../{file}'))\n",
    "\n",
    "df = pd.concat(all_dfs)\n",
    "df"
   ]
  },
